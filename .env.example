# 复制为 .env.local 并填入 Supabase 项目信息。
# 配置完成后运行 npm run supabase:check 验证，然后重启 npm run dev。
# 若留空，应用以「本地存储模式」运行（数据存在浏览器，方便演示）。

# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 图片 bucket，需与 supabase/schema.sql 中一致
VITE_SUPABASE_BUCKET=note-images

# 分享链接的公开访问地址（可选）。留空则使用当前浏览器域名。
# 本地开发时若需生成线上链接，填入已部署地址，例如 https://marknote.example.com
# VITE_PUBLIC_URL=https://marknote.example.com
VITE_PUBLIC_URL=https://my-dairy-notes.netlify.app